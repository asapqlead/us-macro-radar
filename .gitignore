# ================================================================
# US Macro Radar - Git Ignore Configuration
# ================================================================

# ----------------------------------------------------------------
# 1. Environment & Secret Credentials (CRITICAL - NEVER COMMIT)
# ----------------------------------------------------------------
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Always allow template example file for repository cloning
!.env.example

# Security keys, certificates, tokens
*.pem
*.key
*.crt
*.cert
*.pfx
*.p12
id_rsa
id_ecdsa
id_ed25519

# ----------------------------------------------------------------
# 2. Dependencies
# ----------------------------------------------------------------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ----------------------------------------------------------------
# 3. Next.js Build Outputs & Local Caches
# ----------------------------------------------------------------
/.next/
/out/
/build
/dist
next-env.d.ts.bak

# ----------------------------------------------------------------
# 4. Testing & Code Coverage
# ----------------------------------------------------------------
/coverage
*.lcov
.vitest/

# ----------------------------------------------------------------
# 5. Logs & Debugger Dumps
# ----------------------------------------------------------------
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ----------------------------------------------------------------
# 6. Operating System Artifacts
# ----------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini

# Linux
*~

# ----------------------------------------------------------------
# 7. IDEs & Editors
# ----------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak

# ----------------------------------------------------------------
# 8. Hosting & Tooling Caches
# ----------------------------------------------------------------
.vercel
*.tsbuildinfo

# ----------------------------------------------------------------
# 9. Agent & Development Artifacts
# ----------------------------------------------------------------
# Agent-specific metadata files
.agents/*


# Test artifacts and AI-generated drafts
/temp/
/drafts/
*~
