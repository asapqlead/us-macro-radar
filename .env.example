# St. Louis Federal Reserve Economic Data (FRED) API Key
# Request a free API key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Optional: Server cache revalidation period in seconds (default is 3600s / 1hr)
# FRED_CACHE_TTL_SECONDS=3600
